{
  "allow-lan": true,
  "bind-address": "192.168.2.4",
  "dns": {
    "default-nameserver": [
      "223.5.5.5",
      "119.29.29.29"
    ],
    "direct-nameserver": [
      "https://dns.alidns.com/dns-query"
    ],
    "enable": true,
    "enhanced-mode": "redir-host",
    "ipv6": false,
    "listen": "192.168.2.4:53",
    "nameserver": [
      "https://1.1.1.1/dns-query#PROXY",
      "https://8.8.8.8/dns-query#PROXY"
    ],
    "nameserver-policy": {
      "+.deepseek.com": [
        "https://dns.alidns.com/dns-query",
        "https://doh.pub/dns-query"
      ],
      "__SUBSCRIPTION_HOST__": [
        "https://dns.alidns.com/dns-query",
        "https://doh.pub/dns-query"
      ],
      "geosite:cn,private": [
        "https://dns.alidns.com/dns-query",
        "https://doh.pub/dns-query"
      ],
      "geosite:geolocation-!cn": [
        "https://1.1.1.1/dns-query#PROXY",
        "https://8.8.8.8/dns-query#PROXY"
      ],
      "rule-set:proxy-domains": [
        "https://1.1.1.1/dns-query#PROXY",
        "https://8.8.8.8/dns-query#PROXY"
      ]
    },
    "proxy-server-nameserver": [
      "https://dns.alidns.com/dns-query"
    ],
    "use-hosts": true
  },
  "external-controller": "127.0.0.1:9090",
  "geo-auto-update": true,
  "geo-update-interval": 24,
  "geodata-loader": "memconservative",
  "geodata-mode": true,
  "geox-url": {
    "geoip": "https://github.com/MetaCubeX/meta-rules-dat/releases/download/latest/geoip-lite.dat",
    "geosite": "https://github.com/MetaCubeX/meta-rules-dat/releases/download/latest/geosite.dat"
  },
  "hosts": {
    "ai.lan": "192.168.2.4",
    "ai.local": "192.168.2.4"
  },
  "ipv6": false,
  "log-level": "warning",
  "mixed-port": 7890,
  "mode": "rule",
  "profile": {
    "store-fake-ip": false,
    "store-selected": false
  },
  "proxy-groups": [
    {
      "empty-fallback": "REJECT",
      "exclude-type": "Direct|Compatible",
      "interval": 0,
      "lazy": true,
      "max-failed-times": 2,
      "name": "US_AUTO",
      "timeout": 5000,
      "tolerance": 100,
      "type": "url-test",
      "url": "https://www.gstatic.com/generate_204",
      "use": [
        "us"
      ]
    },
    {
      "empty-fallback": "REJECT",
      "exclude-type": "Direct|Compatible",
      "interval": 0,
      "lazy": true,
      "max-failed-times": 2,
      "name": "OTHER_AUTO",
      "timeout": 5000,
      "tolerance": 100,
      "type": "url-test",
      "url": "https://www.gstatic.com/generate_204",
      "use": [
        "other"
      ]
    },
    {
      "empty-fallback": "REJECT",
      "name": "PROXY",
      "proxies": [
        "US_AUTO",
        "OTHER_AUTO"
      ],
      "type": "select"
    }
  ],
  "proxy-providers": {
    "other": {
      "exclude-filter": "(?i)(故障|维护|維護|维修|維修|异常|異常|暂停|暫停|停用|下线|下線|不可用|失效|宕机|宕機|离线|離線|恢复中|恢復中|修复中|修復中|将在|將在|将于|將於|待恢复|待恢復|预计.*恢复|預計.*恢復|offline|maintenance|unavailable|disabled|recovering|repairing|\\bdown\\b|剩余|到期|官网|套餐|流量|有效期|重置|订阅|更新|IPv6)|(?i)(美国|美國|🇺🇸|united\\s*states|\\bUSA?\\b)",
      "header": {
        "User-Agent": [
          "mihomo"
        ]
      },
      "health-check": {
        "enable": false,
        "expected-status": 204,
        "interval": 0,
        "lazy": true,
        "timeout": 5000,
        "url": "https://www.gstatic.com/generate_204"
      },
      "interval": 21600,
      "path": "providers/other.txt",
      "proxy": "DIRECT",
      "size-limit": 8388608,
      "type": "http",
      "url": "__SUBSCRIPTION_URL__"
    },
    "us": {
      "exclude-filter": "(?i)(故障|维护|維護|维修|維修|异常|異常|暂停|暫停|停用|下线|下線|不可用|失效|宕机|宕機|离线|離線|恢复中|恢復中|修复中|修復中|将在|將在|将于|將於|待恢复|待恢復|预计.*恢复|預計.*恢復|offline|maintenance|unavailable|disabled|recovering|repairing|\\bdown\\b|剩余|到期|官网|套餐|流量|有效期|重置|订阅|更新|IPv6)",
      "filter": "(?i)(美国|美國|🇺🇸|united\\s*states|\\bUSA?\\b)",
      "header": {
        "User-Agent": [
          "mihomo"
        ]
      },
      "health-check": {
        "enable": false,
        "expected-status": 204,
        "interval": 0,
        "lazy": true,
        "timeout": 5000,
        "url": "https://www.gstatic.com/generate_204"
      },
      "interval": 21600,
      "path": "providers/us.txt",
      "proxy": "DIRECT",
      "size-limit": 8388608,
      "type": "http",
      "url": "__SUBSCRIPTION_URL__"
    }
  },
  "rule-providers": {
    "proxy-domains": {
      "behavior": "domain",
      "format": "yaml",
      "path": "/etc/net-gateway/proxy-domains.yaml",
      "type": "file"
    }
  },
  "rules": [
    "IP-CIDR,192.168.0.0/16,DIRECT,no-resolve",
    "IP-CIDR,10.0.0.0/8,DIRECT,no-resolve",
    "IP-CIDR,172.16.0.0/12,DIRECT,no-resolve",
    "DOMAIN,ai.lan,DIRECT",
    "DOMAIN,ai.local,DIRECT",
    "DOMAIN-SUFFIX,deepseek.com,DIRECT",
    "RULE-SET,proxy-domains,PROXY",
    "GEOSITE,private,DIRECT",
    "GEOSITE,cn,DIRECT",
    "GEOSITE,geolocation-!cn,PROXY",
    "GEOIP,CN,DIRECT",
    "MATCH,PROXY"
  ],
  "secret": "__MIHOMO_SECRET__",
  "sniffer": {
    "enable": true,
    "parse-pure-ip": true,
    "sniff": {
      "HTTP": {
        "ports": [
          80,
          8080
        ]
      },
      "QUIC": {
        "ports": [
          443
        ]
      },
      "TLS": {
        "ports": [
          443
        ]
      }
    }
  },
  "tun": {
    "auto-detect-interface": true,
    "auto-redirect": true,
    "auto-route": true,
    "device": "gw-tun",
    "dns-hijack": [
      "any:53",
      "tcp://any:53"
    ],
    "enable": true,
    "exclude-uid": [
      999
    ],
    "mtu": 1500,
    "route-exclude-address": [
      "192.168.1.0/24",
      "192.168.2.0/24",
      "10.203.0.0/30"
    ],
    "stack": "mixed",
    "strict-route": true
  }
}
