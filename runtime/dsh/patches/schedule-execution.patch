+/** Host-only external execution vocabulary. MIT: retained package LICENSE applies. */
+import { z } from 'zod';
+export const EXECUTION_CALLBACK_TIMEOUT_MS = 15_000;
+export const executionIdentitySchema = z.string().min(1).max(256).refine(value => value.trim() === value);
+export const executionStatusSchema = z.enum(['pending', 'started', 'completed', 'skipped', 'failed', 'interrupted', 'expired']);
+export const executionResultSchema = z.object({
+    executionId: executionIdentitySchema.optional(),
+    status: executionStatusSchema.exclude(['pending']),
+    summary: z.string().max(4_000).optional(),
+    executionSessionId: executionIdentitySchema.optional(),
+}).strict();
+const instantSchema = z.iso.datetime({ precision: 3 }).refine(value => !value.startsWith('0000-'));
+export const executionReceiptSchema = z.object({
+    kind: z.literal('execution'), executionId: executionIdentitySchema,
+    scheduledAt: instantSchema, deliveredAt: instantSchema,
+    status: executionStatusSchema, summary: z.string().max(4_000).optional(),
+    executionSessionId: executionIdentitySchema.optional(),
+}).strict();
+/** Common identity, without inventing a message for external work. */
+export const deliveryIdentity = receipt => receipt.messageId ?? receipt.executionId;
+/** Bounded callback; late replies are ignored, and the same id remains reconcilable. */
+export async function invokeExecutor(executor, request) {
+    const controller = new AbortController();
+    let timer;
+    try {
+        const timeout = new Promise((_, reject) => {
+            timer = setTimeout(() => {
+                controller.abort(new Error('External executor admission timed out'));
+                reject(controller.signal.reason);
+            }, EXECUTION_CALLBACK_TIMEOUT_MS);
+        });
+        return executionResultSchema.parse(await Promise.race([
+            Promise.resolve().then(() => executor({ ...request, signal: controller.signal })), timeout,
+        ]));
+    } finally {
+        clearTimeout(timer);
+    }
+}
