[Unit]
Description=DeepSeek Harness Web
Wants=network-online.target
After=network-online.target
[Service]
Type=simple
User=dsh
Group=dsh
WorkingDirectory=/var/lib/dsh/workspace
Environment=DSH_HOME=/var/lib/dsh/state
Environment=NODE_OPTIONS=--max-old-space-size=768
ExecStart=/opt/dsh/node_modules/.bin/dsh web --no-open --host 192.168.2.4 --port 80 --trusted-host ai.lan --trusted-host ai.local
Restart=on-failure
RestartSec=10
MemoryAccounting=true
MemoryHigh=1G
MemoryMax=2G
MemorySwapMax=0
CPUQuota=100%
Nice=10
TasksMax=256
NoNewPrivileges=true
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/dsh
UMask=0077
[Install]
WantedBy=multi-user.target
