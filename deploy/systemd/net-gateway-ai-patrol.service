[Unit]
Description=Autonomous DSH network maintainer
After=net-gateway-agent.service net-gateway-control-route.service
[Service]
Type=oneshot
User=dsh
Group=dsh
SupplementaryGroups=gateway-operators
WorkingDirectory=/var/lib/dsh/workspace
Environment=DSH_HOME=/var/lib/dsh/state
Environment=NODE_OPTIONS=--max-old-space-size=768
ExecStart=/usr/bin/python3 /usr/local/lib/net-gateway-agent/ai_job.py
TimeoutStartSec=600
MemoryMax=1536M
MemorySwapMax=0
CPUQuota=100%
Nice=10
TasksMax=256
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
BindReadOnlyPaths=/etc/net-gateway-agent/resolv.conf:/etc/resolv.conf
ReadWritePaths=/var/lib/dsh-login /var/lib/dsh/state/logs /var/lib/dsh/workspace /var/lib/dsh/state/sessions /var/lib/dsh/state/storages /var/lib/dsh/state/profiles/headless/cordis.yml
TimeoutStopSec=10
LimitFSIZE=64M
Environment=TMPDIR=/var/lib/dsh/workspace/.maintenance-tmp
