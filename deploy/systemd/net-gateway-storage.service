[Unit]
Description=Bound logs and background records independently of model availability
[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/lib/net-gateway-agent/storage.py
TimeoutStartSec=50
MemoryMax=128M
CPUQuota=25%
Nice=15
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/net-gateway-agent /var/lib/dsh/state /var/lib/dsh/workspace
