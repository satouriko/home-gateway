#!/usr/bin/env python3
import json
import socket
import sys

request={'operation':sys.argv[1] if len(sys.argv)>1 else 'status'}
if len(sys.argv)>2:request['target']=sys.argv[2]
with socket.socket(socket.AF_UNIX,socket.SOCK_STREAM) as connection:
    connection.settimeout(140);connection.connect('/run/net-gateway-agent/control.sock')
    connection.sendall(json.dumps(request).encode()+b'\n')
    result=connection.makefile('rb').readline(1048576)
print(result.decode().strip())
raise SystemExit(0 if json.loads(result).get('ok') else 1)
